#include <Wire.h>
#include <Adafruit_BMP085.h>
#include <Adafruit_MPU6050.h>
#include <Adafruit_SSD1306.h>
#include <Servo.h>

#define PIN_POT    A0
#define PIN_LED_R  6
#define PIN_LED_G  5
#define PIN_LED_B  3
#define PIN_SERVO  9

#define OLED_W    128
#define OLED_H    64
#define OLED_ADDR 0x3C

#define ALT_MAX      400.0
#define ALT_MIN      150.0
#define THRESHOLD    250.0
#define DECAY_NORMAL 0.05
#define DECAY_VELA   0.25
#define CICLO_MS     2000

#define SERVO_OFF 10
#define SERVO_ON  160

Adafruit_BMP085  bmp;
Adafruit_MPU6050 mpu;
Adafruit_SSD1306 display(OLED_W, OLED_H, &Wire, -1);
Servo velaServo;

float altKm   = ALT_MAX;
float decay   = DECAY_NORMAL;
bool  velaOn  = false;
bool  bmpOk   = false;
bool  mpuOk   = false;
float temp    = 0;
float pressao = 0;
float az      = 0;
unsigned long t0 = 0;

void setLED(uint8_t r, uint8_t g, uint8_t b) {
  analogWrite(PIN_LED_R, r);
  analogWrite(PIN_LED_G, g);
  analogWrite(PIN_LED_B, b);
}

float tempoRestante() {
  if (decay <= 0) return 99999;
  return (altKm - ALT_MIN) / decay;
}

void lerSensors() {
  int pot = analogRead(PIN_POT);
  altKm = map(pot, 0, 1023, (int)ALT_MIN, (int)ALT_MAX);

  if (bmpOk) {
    temp    = bmp.readTemperature();
    pressao = bmp.readPressure();
  }

  if (mpuOk) {
    sensors_event_t a, g, t;
    mpu.getEvent(&a, &g, &t);
    az = a.acceleration.z;
  }
}

void calcDecay() {
  decay = DECAY_NORMAL;
  if (bmpOk && pressao > 101000.0) decay += 0.02;
  if (mpuOk && abs(az) > 11.0)     decay += 0.01;
  if (velaOn) decay = DECAY_VELA;
}

void checkThreshold() {
  if (!velaOn && altKm <= THRESHOLD) {
    velaOn = true;
    velaServo.write(SERVO_ON);
    Serial.println("VELA ATIVADA");
  }
  if (velaOn && altKm > THRESHOLD + 10.0) {
    velaOn = false;
    velaServo.write(SERVO_OFF);
    Serial.println("vela recolhida");
  }
}

void updateLED() {
  float margem = altKm - THRESHOLD;
  if (velaOn)           setLED(255, 0, 0);
  else if (margem < 30) setLED(255, 80, 0);
  else                  setLED(0, 200, 0);
}

void updateDisplay() {
  float tr = tempoRestante();
  display.clearDisplay();

  display.setTextSize(1);
  display.setCursor(0, 0);
  display.print("SDM ");
  display.print(velaOn ? "[VELA ON]" : "[monit.]");
  display.drawLine(0, 10, 127, 10, SSD1306_WHITE);

  display.setTextSize(2);
  display.setCursor(0, 14);
  display.print((int)altKm);
  display.setTextSize(1);
  display.print(" km");

  display.setCursor(0, 33);
  display.print("decay: ");
  display.print(decay, 3);

  display.setCursor(0, 43);
  display.print("T-orb: ");
  display.print(tr > 9999 ? 9999 : (int)tr);
  display.print(" c");

  display.setCursor(0, 53);
  display.print("temp: ");
  display.print(temp, 1);
  display.print("C");

  int barW = map((int)altKm, (int)ALT_MIN, (int)ALT_MAX, 0, 50);
  int thrX = map((int)THRESHOLD, (int)ALT_MIN, (int)ALT_MAX, 76, 126);
  display.drawRect(76, 33, 50, 8, SSD1306_WHITE);
  display.fillRect(76, 33, barW, 8, SSD1306_WHITE);
  display.drawLine(thrX, 32, thrX, 42, SSD1306_WHITE);

  display.display();
}

void setup() {
  Serial.begin(9600);

  pinMode(PIN_LED_R, OUTPUT);
  pinMode(PIN_LED_G, OUTPUT);
  pinMode(PIN_LED_B, OUTPUT);
  pinMode(PIN_SERVO, OUTPUT);

  velaServo.attach(PIN_SERVO);
  velaServo.write(SERVO_OFF);

  Wire.begin();

  if (bmp.begin()) bmpOk = true;
  if (mpu.begin()) {
    mpuOk = true;
    mpu.setAccelerometerRange(MPU6050_RANGE_8_G);
    mpu.setGyroRange(MPU6050_RANGE_500_DEG);
    mpu.setFilterBandwidth(MPU6050_BAND_21_HZ);
  }

  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR)) {
    while (true);
  }

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(20, 28);
  display.println("iniciando...");
  display.display();
  setLED(0, 0, 50);
  delay(1500);
}

void loop() {
  if (millis() - t0 < CICLO_MS) return;
  t0 = millis();

  lerSensors();
  calcDecay();
  checkThreshold();
  updateLED();
  updateDisplay();

  Serial.print("alt="); Serial.print(altKm, 1);
  Serial.print(" decay="); Serial.print(decay, 3);
  Serial.print(" vela="); Serial.println(velaOn ? 1 : 0);
}
